<mvc:View controllerName="com.training.exer3chan.controller.MainView" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page id="page" class="pageTitle" title="{i18n>title}" floatingFooter="true">
        <content>
            <VBox id="idVBox" class="sapUiSmallMargin">
                <f:SimpleForm id="idSimpleForm" editable="true" layout="ResponsiveGridLayout" class="nameForm" title="{i18n>details}"  labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="4" emptySpanL="4" emptySpanM="4" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false">
                    <f:content>
                        <Label id="idLblFName" text="{i18n>firstNameLbl}" />
                        <Input id="idInptFName" value="" />
                        <Label id="idLblLName" text="{i18n>lastNameLbl}" />
                        <Input id="idInptLName" value="" />
                        <Label id="idLblMOP" text="{i18n>MOPLbl}" />
                        <Select id="idSelMOP" forceSelection="false" change="onChangeMOP">
                            <items>
                                <core:Item id="idItmCOD" text="{i18n>codItem}" key="COD"/>
                                <core:Item id="idItmCC" text="{i18n>ccItem}" key="CC"/>
                                <core:Item id="idItmGCash" text="{i18n>gcashItem}" key="GCASH"/>
                            </items>
                        </Select>
                        <Label id="idLblPhone" text="{i18n>mobileLbl}" visible="false"/>
                        <Input id="idInputPhone" value="" visible="false"/>
                        <Label id="idLblCC" text="{i18n>creditCardLbl}" visible="false"/>
                        <Input id="idInputCC" value="" visible="false"/>
                    </f:content>
                </f:SimpleForm>
               <core:Fragment fragmentName="com.training.exer3chan.fragment.ShoppingCart" type="XML" />
            </VBox>
        </content>
        <footer>
            <OverflowToolbar id="idOFTFooter" class="footertoolbar">
                <ToolbarSpacer id="idTSpacerFooter"/>
                <Button id="idBtnCheckout" text="{i18n>checkOutTextTip}" tooltip="{i18n>checkOutTextTip}" press="onPressCheckout"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>